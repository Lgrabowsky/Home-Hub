# Name under which the hub is reachable (without https://).
#   own domain / DynDNS:  zuhause.example.de
#   Tailscale:            mein-rechner.mein-tailnet.ts.net
HUB_DOMAIN=

# Only needed when the hub is reachable from the internet (not for Tailscale/VPN):
# public name and port of the media port, which must be forwarded on the router (TCP + UDP).
# Example: zuhause.example.de:8555
HUB_WEBRTC_CANDIDATES=

# Optional: 32 random bytes (create with `openssl rand -base64 32`). If set, the key that
# protects stored passwords is not kept next to the data.
HUB_MASTER_KEY=
